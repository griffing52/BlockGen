\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces \textbf  {A second domain, with real colors.} Three LDraw.org OMR models in their own LEGO colors: the exterior an exterior protocol sees, the same parts cut past one plane, and the occupancy grid we derive sliced at that plane, sealed interior in peach, every other color the parts' own, all renders at one scale. This domain shares only the fact that builds enclose space: different parts, different lattice, different renderer, $190$--$390$ parts against thousands of blocks. The measured replication of \S  \ref {sec:lego} runs on StableText2Brick rather than on these three models, which we picture because their terms permit it (Appendix~\ref {app:data}). Official LEGO sets are far less hollow than either measured corpus: among models with at least eight sealed cells, the basis the OMR audit reports, \mbox  {\textsc  {Fill-Interior}}{} adds a median $+1.2\%$ mass to an OMR model against $+35.8\%$ to a held-out house. Models: Small Cottage (Stefan Frenz), Apple Tree House (Marc Giraudet), Lakeside Lodge (Stefan Frenz); LDraw.org OMR, CC BY 2.0, modified only by the deletions shown.}}{27}{figure.6}\protected@file@percent }
\newlabel{fig:lego}{{6}{27}{\textbf {A second domain, with real colors.} Three LDraw.org OMR models in their own LEGO colors: the exterior an exterior protocol sees, the same parts cut past one plane, and the occupancy grid we derive sliced at that plane, sealed interior in peach, every other color the parts' own, all renders at one scale. This domain shares only the fact that builds enclose space: different parts, different lattice, different renderer, $190$--$390$ parts against thousands of blocks. The measured replication of \S \ref {sec:lego} runs on StableText2Brick rather than on these three models, which we picture because their terms permit it (Appendix~\ref {app:data}). Official LEGO sets are far less hollow than either measured corpus: among models with at least eight sealed cells, the basis the OMR audit reports, \solidify {} adds a median $+1.2\%$ mass to an OMR model against $+35.8\%$ to a held-out house. Models: Small Cottage (Stefan Frenz), Apple Tree House (Marc Giraudet), Lakeside Lodge (Stefan Frenz); LDraw.org OMR, CC BY 2.0, modified only by the deletions shown}{figure.6}{}}
\newlabel{fig:lego@cref}{{[figure][6][]6}{[1][26][]27}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces \textbf  {The two metrics disagree about real builds, with no probe involved.} The unbiased estimator is a sum over builds, so each build's contribution to its arm's score is recoverable. The six builds each metric penalizes most are shown with their contribution and their sealed interior volume. The two orderings are nearly independent, $\rho = +0.167$, and only the geometric ordering tracks how much interior a build has: its rank correlation with sealed interior volume is $-0.343$ ($p < 0.001$) against $-0.014$ for the render metric. Builds shown are 3D-Craft only, for licensing.}}{28}{figure.7}\protected@file@percent }
\newlabel{fig:influence}{{7}{28}{\textbf {The two metrics disagree about real builds, with no probe involved.} The unbiased estimator is a sum over builds, so each build's contribution to its arm's score is recoverable. The six builds each metric penalizes most are shown with their contribution and their sealed interior volume. The two orderings are nearly independent, $\rho = +0.167$, and only the geometric ordering tracks how much interior a build has: its rank correlation with sealed interior volume is $-0.343$ ($p < 0.001$) against $-0.014$ for the render metric. Builds shown are 3D-Craft only, for licensing}{figure.7}{}}
\newlabel{fig:influence@cref}{{[figure][7][]7}{[1][26][]28}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces \textbf  {One estimator, three feature maps.} \mbox  {MV-KID}{} and \mbox  {V-KID}{} are the same unbiased kernel distance of Eq.~\ref {eq:mmd} and differ only in $\phi $. \emph  {Row 1:} the render-and-embed path, where the structure reaches the statistic as four images. \emph  {Row 2:} the same renderer and the same encoder with cutaway views, which recovers the signal. One renderer, one encoder, only the views differ, and four other encoders and $8$ or $16$ views change nothing (Table~\ref {tab:ablation}). \emph  {Row 3:} the geometric path, which reads occupancy directly and needs no renderer and no GPU. A noise floor is a run's own real-vs-real spread and falls with $n$, so separations compare within a run: rows $1$ and $3$ come from one scorecard at $n{=}128$ against $399$ reference builds, and row $2$ from the view ablation at $n{=}256$, where row $1$ scores $+1.1$. The sections at left are horizontal slices of one 3D-Craft build.}}{28}{figure.8}\protected@file@percent }
\newlabel{fig:pipeline}{{8}{28}{\textbf {One estimator, three feature maps.} \mvkid {} and \vkid {} are the same unbiased kernel distance of Eq.~\ref {eq:mmd} and differ only in $\phi $. \emph {Row 1:} the render-and-embed path, where the structure reaches the statistic as four images. \emph {Row 2:} the same renderer and the same encoder with cutaway views, which recovers the signal. One renderer, one encoder, only the views differ, and four other encoders and $8$ or $16$ views change nothing (Table~\ref {tab:ablation}). \emph {Row 3:} the geometric path, which reads occupancy directly and needs no renderer and no GPU. A noise floor is a run's own real-vs-real spread and falls with $n$, so separations compare within a run: rows $1$ and $3$ come from one scorecard at $n{=}128$ against $399$ reference builds, and row $2$ from the view ablation at $n{=}256$, where row $1$ scores $+1.1$. The sections at left are horizontal slices of one 3D-Craft build}{figure.8}{}}
\newlabel{fig:pipeline@cref}{{[figure][8][]8}{[1][26][]28}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces \textbf  {Both directions of the corruption, on three held-out builds.} \mbox  {\textsc  {Fill-Interior}}{} adds a median $33\%$ blocks and \mbox  {\textsc  {Hollow-Shell}}{} removes a median $13\%$, yet the views the metric is given are near-identical in every column. The cross-sections show what changed, with sealed interior air in peach. \mbox  {MV-KID}{} places both within one noise floor of real ($+1.0$ and $+0.4$); \mbox  {V-KID}{} places them $287$ and $156$ away.}}{29}{figure.9}\protected@file@percent }
\newlabel{fig:gallery}{{9}{29}{\textbf {Both directions of the corruption, on three held-out builds.} \solidify {} adds a median $33\%$ blocks and \hollow {} removes a median $13\%$, yet the views the metric is given are near-identical in every column. The cross-sections show what changed, with sealed interior air in peach. \mvkid {} places both within one noise floor of real ($+1.0$ and $+0.4$); \vkid {} places them $287$ and $156$ away}{figure.9}{}}
\newlabel{fig:gallery@cref}{{[figure][9][]9}{[1][26][]29}{}{}{}}
