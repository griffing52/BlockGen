\@writefile{lof}{\contentsline {figure}{\numberline {15}{\ignorespaces \textbf  {Every arm, ordered by \mbox  {BlockScore}{}.} Six builds per arm: the first six the run recorded, in the seeded order it recorded them, topped up from that arm's full scored sample where fewer than six remain. Builds one voxel thick are passed over, since they draw as a hairline; a fifth of what the two language-model arms emit is that shape, a truncation failure \S  \ref {sec:setting} describes. \mbox  {\textsc  {Real}}{}, \mbox  {\textsc  {Fill-Interior}}{} and \mbox  {\textsc  {Material-Shuffle}}{} are the same six buildings column for column, so a corruption reads down a column and the paper's central claim can be checked by eye: the \mbox  {\textsc  {Fill-Interior}}{} row scores $+201.80$ and does not change. Each build is framed to its own bounding box, so cells are not to a common scale, and \texttt  {DQ} marks an arm a disqualification gate refused a rank (Table~\ref {tab:leaderboard}). Cells marked $\dagger $ are withheld under GrabCraft's terms; no build shown is a memorized copy, the nearest of $1{,}863$ training builds reaching IoU $0.51$. The contaminated checkpoint of \S  \ref {sec:casestudy} is absent: it is unrankable, and a gallery ordered by score would imply a standing it does not have.}}{32}{figure.15}\protected@file@percent }
\newlabel{fig:samples}{{15}{32}{\textbf {Every arm, ordered by \blockscore {}.} Six builds per arm: the first six the run recorded, in the seeded order it recorded them, topped up from that arm's full scored sample where fewer than six remain. Builds one voxel thick are passed over, since they draw as a hairline; a fifth of what the two language-model arms emit is that shape, a truncation failure \S \ref {sec:setting} describes. \realheld {}, \solidify {} and \matshuffle {} are the same six buildings column for column, so a corruption reads down a column and the paper's central claim can be checked by eye: the \solidify {} row scores $+201.80$ and does not change. Each build is framed to its own bounding box, so cells are not to a common scale, and \texttt {DQ} marks an arm a disqualification gate refused a rank (Table~\ref {tab:leaderboard}). Cells marked $\dagger $ are withheld under GrabCraft's terms; no build shown is a memorized copy, the nearest of $1{,}863$ training builds reaching IoU $0.51$. The contaminated checkpoint of \S \ref {sec:casestudy} is absent: it is unrankable, and a gallery ordered by score would imply a standing it does not have}{figure.15}{}}
\newlabel{fig:samples@cref}{{[figure][15][]15}{[1][30][]32}{}{}{}}
