\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces \textbf  {A building is not its silhouette.} \emph  {Left:} a real build, sectioned vertically through its sealed interior, shown in peach. \emph  {Right:} the same build under \mbox  {\textsc  {Fill-Interior}}{}, every sealed void filled by its own dominant material and cut on the same plane, almost indistinguishable in all four views the metric renders. \mbox  {MV-KID}{} separates the two by $0.14$ of its own noise floor, which leaves them in one significance group, while \mbox  {V-KID}{} separates them by $202$. Renders use the metric's own texture pack; published builds come from 3D-Craft (Appendix~\ref {app:data}).}}{2}{figure.1}\protected@file@percent }
\newlabel{fig:teaser}{{1}{2}{\textbf {A building is not its silhouette.} \emph {Left:} a real build, sectioned vertically through its sealed interior, shown in peach. \emph {Right:} the same build under \solidify {}, every sealed void filled by its own dominant material and cut on the same plane, almost indistinguishable in all four views the metric renders. \mvkid {} separates the two by $0.14$ of its own noise floor, which leaves them in one significance group, while \vkid {} separates them by $202$. Renders use the metric's own texture pack; published builds come from 3D-Craft (Appendix~\ref {app:data})}{figure.1}{}}
